    "model_name": "Silero TTS V4",
    "model_type": "silero_v4",
    "group": "numbers",
    "item_id": "numbers_06",
    "text": "Лампа коптила много столетий, потому что ламповое стекло изобрели лишь во второй половине XVIII в.",
    "audio_path": "results/audio/silero_tts_v4_ru_numbers_numbers_06.wav",
